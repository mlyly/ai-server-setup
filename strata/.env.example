# ==============================================================================
# REQUIRED: PostgreSQL & LiteLLM Database Connection
# ==============================================================================
# Used by the `postgres` healthcheck and `litellm` (`os.environ/DATABASE_URL`).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, and host `postgres`
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ==============================================================================
# REQUIRED: LiteLLM Proxy & Open WebUI Authentication
# ==============================================================================
# Master API key for LiteLLM admin/API access; also passed to Open WebUI.
# Generate a strong key, e.g.: openssl rand -hex 32
LITELLM_MASTER_KEY=

# ==============================================================================
# REQUIRED (if Strata enforces auth): Strata Backend Key
# ==============================================================================
# Referenced in `docker-compose.yml` (STRATA_API_KEY) and `litellm_config.yaml`
# (`os.environ/STRATA_API_KEY`). Set to a dummy value if Strata has auth disabled.
STRATA_API_KEY=

# ==============================================================================
# OPTIONAL: LiteLLM & Open WebUI Tuning
# ==============================================================================
# LiteLLM salt key for encrypting stored provider credentials/keys in Postgres
# LITELLM_SALT_KEY=

# Disable LiteLLM telemetry/callbacks if desired
# LITELLM_TELEMETRY=False

# Open WebUI secret key for session signing across container restarts
WEBUI_SECRET_KEY=

# Optional Qdrant API key if you enable authentication on Qdrant
# QDRANT_API_KEY=

# Optional Hugging Face token if pulling gated models
# HF_TOKEN=
