{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-v100": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local G431-MM1 V100 Cluster",
      "options": {
        // Change to http://localhost:4000/v1 if running OpenCode directly on the Docker host
        "baseURL": "http://llm-1:4000/v1",
        // Must match LITELLM_MASTER_KEY in your .env
        "apiKey": "sk-change-this-to-a-strong-master-key"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8-Flash-Next (GPUs 0-1 Architect)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen3.8-27b-coder": {
          "name": "Qwen3.8-27B Thinking (GPU 2 Coder)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen3.8-27b-fast": {
          "name": "Qwen3.8-27B Fast Parallel (GPU 2 Worker)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  // Primary interactive / coding model
  "model": "local-v100/qwen3.8-27b-coder",
  // Lightweight / high-throughput tasks
  "small_model": "local-v100/qwen3.8-27b-fast",
  "agent": {
    // Architect / planning role
    "plan": {
      "model": "local-v100/qwen3.8-flash-next"
    },
    // Main implementation / coding role
    "build": {
      "model": "local-v100/qwen3.8-27b-coder"
    },
    // Fast parallel worker / codebase exploration role
    "explore": {
      "model": "local-v100/qwen3.8-27b-fast"
    },
    // Optional sub-agent alias if your workflow uses a dedicated worker/general agent
    "general": {
      "model": "local-v100/qwen3.8-27b-fast"
    }
  }
}
